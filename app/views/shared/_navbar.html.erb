<nav class="navbar navbar-light site-navbar" aria-label="Primary navigation">
  <div class="container-fluid site-navbar__inner">
    <%= link_to :root, class: "site-navbar__brand", aria: { label: "Pawneighbour home" } do %>
      <%= image_tag "icons/android-icon-192x192.png", alt: "", class: "site-navbar__logo" %>
      <span class="site-navbar__wordmark">Pawneighbour</span>
      <span class="site-navbar__edition" aria-hidden="true">SYD · 2026</span>
    <% end %>

    <div class="ms-auto">
      <% if user_signed_in? %>
        <div class="site-navbar__signed-in">
          <%= link_to "Help board", listings_path, class: "site-navbar__text-link d-none d-sm-inline-flex" %>
          <%= link_to new_listing_path, class: "site-navbar__post d-none d-sm-inline-flex" do %>
            Pin a request <span aria-hidden="true">↗</span>
          <% end %>
          <%= link_to new_amber_alert_path, class: "site-navbar__post d-none d-sm-inline-flex" do %>
            Report a missing <span aria-hidden="true">↗</span>
          <% end %>
          <div class="dropdown">
          <button class="site-navbar__account" type="button"
                  data-bs-toggle="dropdown"
                  aria-expanded="false"
                  aria-label="<%= @activity_attention_count.to_i.positive? ? "Account menu, attention needed for #{pluralize(@activity_attention_count, 'activity item')}" : "Account menu" %>">
            <%= avatar_for(current_user) %>

            <% if @activity_attention_count.to_i.positive? %>
              <span class="site-navbar__attention" aria-hidden="true">
                <%= @activity_attention_count %>
              </span>
            <% end %>
          </button>

          <ul class="dropdown-menu dropdown-menu-end">
            <li class="dropdown-header"><%= current_user.name %></li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <%= link_to mine_listings_path,
                          class: "dropdown-item d-flex justify-content-between align-items-center gap-3" do %>
                <span>My activity</span>

                <% if @activity_attention_count.to_i.positive? %>
                  <span class="badge rounded-pill text-bg-warning">
                    <%= @activity_attention_count %>
                  </span>
                <% end %>
              <% end %>
            </li>
            <li><%= link_to "Help board", listings_path, class: "dropdown-item" %></li>
            <li><%= link_to "Lost & Found", amber_alerts_path, class: "dropdown-item" %></li>
            <li><hr class="dropdown-divider"></li>
            <li><%= link_to "Log out", destroy_user_session_path,
                            data: { turbo_method: :delete }, class: "dropdown-item" %></li>
          </ul>
          </div>
        </div>
      <% else %>
        <div class="site-navbar__public">
          <%= link_to "How it works", root_path(anchor: "how-it-works"),
                      class: "site-navbar__text-link site-navbar__public-link d-none d-md-inline-flex" %>
          <%= link_to "Log in", new_user_session_path,
                      class: "site-navbar__login" %>
          <%= link_to new_user_registration_path,
                      class: "site-navbar__post site-navbar__join" do %>
            Join the pack <span aria-hidden="true">↗</span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</nav>
