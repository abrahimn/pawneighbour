<% content_for :title, "Report a missing pet | PawNeighbour" %>

<main class="page-shell alerts-page">
  <div class="row">
    <div class="col-12 col-md-8 col-lg-6 mx-auto">

      <%= link_to amber_alerts_path, class: "btn btn-link px-0 mb-3" do %>
        <i class="fa-solid fa-chevron-left me-1" aria-hidden="true"></i> All alerts
      <% end %>

      <div class="alerts-hero mb-4">
        <p class="alerts-hero__eyebrow">Community alert</p>
        <h1 class="alerts-hero__title">Report a missing pet</h1>
        <p class="alerts-hero__description mb-0">
          Neighbours nearby will see this straight away. The more precise the
          location, the more useful it is.
        </p>
      </div>

      <%= simple_form_for @alert do |f| %>
        <%= f.error_notification %>

        <%= f.association :pet,
                          collection: @pets,
                          label_method: :name,
                          value_method: :id,
                          label: "Which pet is missing?",
                          include_blank: "Choose a pet",
                          required: true %>

        <%= f.input :location,
            required: true,
            label: "Where were they last seen?",
            input_html: {
              class: "d-none",
              data: { address_autocomplete_target: "address" }
            },
            wrapper_html: {
              class: "address-field",
              data: {
                controller: "address-autocomplete",
                address_autocomplete_api_key_value: ENV["MAPBOX_API_KEY"],
                address_autocomplete_types_value: "poi,address,neighborhood,locality",
                address_autocomplete_proximity_value:
                  ([current_user.longitude, current_user.latitude].compact.presence || []).to_json
              }
            } %>

        <div class="row g-2">
          <div class="col-6">
            <%= f.input :date, as: :string, label: "Date",
                        input_html: { type: "date", value: Date.current, max: Date.current },
                        required: true %>
          </div>
          <div class="col-6">
            <%= f.input :time, as: :string, label: "Time",
                        input_html: { type: "time", value: Time.current.strftime("%H:%M") } %>
          </div>
        </div>

        <%= f.button :submit, "Post alert", class: "btn btn-danger w-100 mt-3" %>
      <% end %>

    </div>
  </div>
</main>
