<% pet      = @alert.pet %>
<% owner    = @alert.creator %>
<% is_owner = owner == current_user %>

<% content_for :title, "#{pet.name} is missing | PawNeighbour" %>

<main class="page-shell alerts-page">

  <%= link_to amber_alerts_path, class: "btn btn-link px-0 mb-3" do %>
    <i class="fa-solid fa-chevron-left me-1" aria-hidden="true"></i> All alerts
  <% end %>

  <article class="alert-detail">

    <%# ---------- who is missing ---------- %>
    <div class="alert-detail__head">
      <img src="<%= pet_photo_url(pet, size: 320) %>"
           class="alert-detail__photo" alt="<%= pet.name %>">

      <div>
        <% if @alert.resolved? %>
          <span class="status-badge status-badge--positive">Found</span>
        <% else %>
          <span class="status-badge status-badge--urgent">Missing</span>
        <% end %>

        <h1 class="alert-detail__name"><%= pet.name %></h1>

        <p class="alert-detail__meta mb-2">
          <%= pet.species %> · <%= pluralize(pet.age, "year") %> old
        </p>

        <div class="d-flex align-items-center gap-2">
          <%= avatar_for(owner, size: 32) %>
          <span class="alert-detail__meta">
            reported by <%= owner.name %>, <%= time_ago_in_words(@alert.created_at) %> ago
          </span>
        </div>
      </div>
    </div>

    <%# ---------- last seen ---------- %>
    <section class="alert-detail__block">
      <h2 class="alert-detail__label">Last seen</h2>
      <p class="mb-1"><strong><%= @alert.location %></strong></p>
      <p class="alert-detail__meta mb-0">
        <%= @alert.last_seen_at %>
        <% if (away = distance_away(current_user, @alert)) %>
          · <%= away %>
        <% end %>
      </p>
    </section>

    <%# ---------- important info ---------- %>
    <% if @alert.details.present? %>
      <section class="alert-detail__block">
        <h2 class="alert-detail__label">Important info</h2>
        <div class="alert-detail__details">
          <%= simple_format(@alert.details) %>
        </div>
      </section>
    <% end %>

    <%# ---------- contact ---------- %>
    <% unless is_owner %>
      <section class="alert-detail__block">
        <h2 class="alert-detail__label">Contact <%= owner.name %></h2>
        <div class="row g-2">
          <% if owner.mobile.present? %>
            <div class="col-12 col-sm-6">
              <%= link_to "tel:#{owner.mobile.gsub(/\s/, '')}",
                          class: "btn btn-danger w-100 d-inline-flex align-items-center justify-content-center gap-2" do %>
                <i class="fa-solid fa-phone" aria-hidden="true"></i>
                <span>Call <%= owner.name %></span>
              <% end %>
            </div>
          <% end %>

          <div class="col-12 col-sm-6">
            <%= mail_to owner.email,
                        class: "btn btn-outline-secondary w-100 d-inline-flex align-items-center justify-content-center gap-2" do %>
              <i class="fa-regular fa-envelope" aria-hidden="true"></i>
              <span>Email <%= owner.name %></span>
            <% end %>
          </div>
        </div>
      </section>
    <% end %>

    <%# ---------- owner: mark as found ---------- %>
    <% if is_owner && !@alert.resolved? %>
      <section class="alert-detail__block">
        <% resolve_form_id = dom_id(@alert, :resolve) %>

        <%= form_with url: resolve_amber_alert_path(@alert),
                      method: :patch,
                      html: { id: resolve_form_id } do %>
          <button type="button"
                  class="btn btn-success w-100"
                  data-bs-toggle="modal"
                  data-bs-target="#found-confirmation-modal">
            Mark <%= pet.name %> as found
          </button>
        <% end %>

        <div class="modal fade confirmation-modal"
             id="found-confirmation-modal"
             tabindex="-1"
             aria-labelledby="found-confirmation-title"
             aria-describedby="found-confirmation-description"
             aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
              <div class="modal-header">
                <span class="confirmation-modal__icon" aria-hidden="true">
                  <i class="fa-solid fa-paw"></i>
                </span>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Keep the alert open"></button>
              </div>

              <div class="modal-body">
                <p class="confirmation-modal__eyebrow">Good news?</p>
                <h2 class="confirmation-modal__title" id="found-confirmation-title">
                  Has <%= pet.name %> come home?
                </h2>
                <p class="confirmation-modal__description" id="found-confirmation-description">
                  This will close the missing pet alert. Neighbours will no longer see it on the alert board.
                </p>
              </div>

              <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                  Not yet
                </button>
                <button type="submit" class="btn btn-success" form="<%= resolve_form_id %>">
                  Yes, mark <%= pet.name %> found
                </button>
              </div>
            </div>
          </div>
        </div>
      </section>
    <% end %>

    <%# ---------- report a sighting ---------- %>
    <% if !is_owner && !@alert.resolved? %>
      <section class="alert-detail__block">
        <h2 class="alert-detail__label">I've seen <%= pet.name %></h2>
        <%= render "amber_alerts/sighting_form", alert: @alert, response: @response, pet: pet %>
      </section>
    <% end %>

    <%# ---------- sightings ---------- %>
    <section class="alert-detail__block">
      <h2 class="alert-detail__label">
        Sightings
        <span class="alert-detail__count <%= "alert-detail__count--zero" if @sightings.size.zero? %>">
          <%= @sightings.size %>
        </span>
      </h2>

      <% if @sightings.any? %>
        <ol class="sighting-list">
          <% @sightings.each do |sighting| %>
            <li class="sighting">
              <div class="sighting__when">
                <%= sighting.date.strftime("%-d %b") %><br>
                <span><%= sighting.time&.strftime("%-l:%M%P") %></span>
              </div>

              <div class="sighting__body">
                <p class="sighting__where mb-1"><%= sighting.location %></p>

                <% if sighting.notes.present? %>
                  <p class="sighting__notes mb-1"><%= sighting.notes %></p>
                <% end %>

                <% if sighting.photos.attached? %>
                  <div class="sighting__photos">
                    <% sighting.photos.each do |photo| %>
                      <%= cl_image_tag photo.key, width: 320, height: 320, crop: :fill,
                                       class: "sighting__photo", alt: "Sighting photo" %>
                    <% end %>
                  </div>
                <% end %>

                <div class="d-flex align-items-center gap-2 mt-1">
                  <%= avatar_for(sighting.spotter, size: 24) %>
                  <span class="sighting__who">reported by <%= sighting.spotter.name %></span>
                </div>
              </div>
            </li>
          <% end %>
        </ol>
      <% else %>
        <p class="alert-detail__meta mb-0">
          No sightings yet. If you've seen <%= pet.name %>, even briefly, it helps.
        </p>
      <% end %>
    </section>



  </article>
</main>
