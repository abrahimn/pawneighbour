<article class="offer-card">
  <div class="card-body d-flex align-items-center justify-content-between gap-3 p-3 p-sm-4">
    <div class="offer-card__person">
      <%= avatar_for(offer.user, size: 56) %>

      <div>
        <h2><%= offer.user.name %></h2>
        <span class="badge rounded-pill text-bg-<%= offer.status == 'accepted' ? 'success' : 'info' %> mt-1">
          <%= offer.status.humanize %>
        </span>
      </div>
    </div>

    <% if offer.status == "offered" %>
      <%= button_to "Accept offer",
                    accept_offer_path(offer),
                    method: :patch,
                    class: "btn btn-primary rounded-pill flex-shrink-0" %>
    <% end %>
  </div>
</article>
