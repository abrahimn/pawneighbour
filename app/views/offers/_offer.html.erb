<div class="card bg-white shadow-sm mb-2">
  <div class="card-body">

    <%# ---------- who ---------- %>
    <div class="d-flex align-items-center gap-3 mb-3">
      <%= avatar_for(offer.user, size: 48) %>

      <div class="lh-sm">
        <h3 class="h6 mb-1"><%= offer.user.name %></h3>
        <p class="text-body-secondary small mb-0">
          <i class="fa-solid fa-location-dot me-1" aria-hidden="true"></i>
          <%= offer.user.location %>
          <% if (away = distance_away(current_user, offer.user)) %>
            · <%= away %>
          <% end %>
        </p>
      </div>
    </div>

    <%# ---------- trust + action ---------- %>
    <div class="d-flex justify-content-between align-items-center gap-3">
      <% if (trust = trust_signal(current_user, offer.user)) %>
        <p class="trust trust--<%= trust[:key] %> small mb-0"><%= trust[:label] %></p>
      <% end %>

      <% if offer.status == "offered" %>
        <%= button_to "Accept", accept_offer_path(offer),
                      method: :patch,
                      class: "btn btn-primary rounded-pill px-4 flex-shrink-0 ms-auto" %>
      <% else %>
        <% label, tone = offer_status_badge(offer.status) %>
        <span class="status-badge status-badge--<%= tone %> ms-auto"><%= label %></span>
      <% end %>
    </div>

  </div>
</div>
