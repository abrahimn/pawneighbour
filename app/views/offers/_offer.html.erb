<div class="card mb-3">
  <div class="card-body">
    <div class="d-flex align-item-center">
      <div>
        <%= avatar_for(offer.user) %>
      </div>
      <div class="card-title m-3">
        <%= offer.user.name %>
      </div>
    </div>
    <% if (trust = trust_signal(current_user, offer.user)) %>
      <p class="trust trust--<%= trust[:key] %> mb-0"><%= trust[:label] %></p>
    <% end %>
    <% if offer.status == "offered" %>
      <%= button_to "Accept",
                    accept_offer_path(offer),
                    method: :patch,
                    class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
