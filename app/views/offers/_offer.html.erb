<div class="card mb-3">
  <div class="card-body">
    <h5 class="card-title"><%= offer.user.name %></h5>

    <p class="card-text">
      Status: <%= offer.status.humanize %>
    </p>
    <% if offer.status == "offered" %>
      <%= button_to "Accept offer",
                    accept_offer_path(offer),
                    method: :patch,
                    class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
