<div class="container py-4">
    <% if @offers.any? %>
      <% @offers.each do |offer| %>
      <%= render "offer", offer: offer %>
      <% end %>
    <% else %>
      <p> No offers for <%= @listing.pet.name %> yet - waiting can be ruff 🐶 </p>
    <% end %>

    <%= link_to "Back to listing",
        listing_path(@listing), class: "btn btn-outline-secondary mb-4" %>
</div>
