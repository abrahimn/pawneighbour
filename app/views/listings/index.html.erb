<% content_for :title, "Help board | PawNeighbour" %>

<main class="page-shell marketplace-page">
  <header class="neighbourhood-hero mb-5" aria-labelledby="nearby-hero-title">
    <span class="neighbourhood-hero__pet neighbourhood-hero__pet--pug" aria-hidden="true">
      <%= image_tag "pug-transparent.png",
                    class: "neighbourhood-hero__pug-layer neighbourhood-hero__pug-body",
                    alt: "" %>
      <%= image_tag "pug-transparent.png",
                    class: "neighbourhood-hero__pug-layer neighbourhood-hero__pug-tongue",
                    alt: "" %>
    </span>

    <span class="neighbourhood-hero__cat" aria-hidden="true">
      <%= image_tag "playful-cat-transparent.png",
                    class: "neighbourhood-hero__cat-layer neighbourhood-hero__cat-body",
                    alt: "" %>
      <%= image_tag "playful-cat-transparent.png",
                    class: "neighbourhood-hero__cat-layer neighbourhood-hero__cat-tail",
                    alt: "" %>
    </span>

    <div class="neighbourhood-hero__content">
      <span class="neighbourhood-hero__issue" aria-hidden="true">COMMUNITY BOARD / 01</span>
      <span class="neighbourhood-hero__eyebrow">
        Live from <%= current_user.location.to_s.split(",").first %>
      </span>

      <h1 class="neighbourhood-hero__title" id="nearby-hero-title">
        <span>Need a hand?</span>
        Find a paw!
      </h1>

      <p class="neighbourhood-hero__description">
        The local noticeboard for walks, drop-ins and last-minute favours.
        No agencies. Just neighbours.
      </p>

      <div class="d-flex flex-column align-items-start w-30">
        <%= link_to new_listing_path,
                    class: "btn neighbourhood-hero__button rounded-pill mb-3" do %>
          Pin a request
          <span aria-hidden="true">↗</span>
        <% end %>

        <%= link_to new_amber_alert_path,
                    class: "btn neighbourhood-hero__button rounded-pill" do %>
          Report a missing
          <span aria-hidden="true">↗</span>
        <% end %>
      </div>
    </div>
    <div class="neighbourhood-hero__stamp" aria-hidden="true">
      <span>NEIGHBOUR</span>
      <strong>TO NEIGHBOUR</strong>
      <span>SINCE 2026</span>
    </div>
  </header>

  <section aria-labelledby="nearby-listings-title">
    <div class="section-heading section-heading--nearby">
      <div class="section-heading__intro">
        <div class="section-heading__title-row">
          <h2 id="nearby-listings-title">On the board</h2>
          <span class="location-chip">
            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
            <%= current_user.location %>
          </span>
        </div>

        <p class="nearby-summary__count" aria-label="Nearby listing summary">
          <strong>
            <% if @nearby_listings.empty? %>
              No listings nearby
            <% elsif @nearby_listings.one? %>
              One listing nearby
            <% else %>
              <%= @nearby_listings.size %> listings nearby
            <% end %>
          </strong>
        </p>
      </div>
    </div>

    <%= render "radius_filter" %>

    <% if @nearby_listings.any? %>
      <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        <%= render partial: "nearby_listing_card",
                   collection: @nearby_listings,
                   as: :listing %>
      </div>
    <% else %>
      <div class="empty-state">
        <span class="empty-state__mark" aria-hidden="true"><i class="fa-solid fa-paw"></i></span>
        <h3 class="h4">No open requests nearby</h3>
        <p class="text-body-secondary mb-0">
          Try increasing your search radius or check back later.
        </p>
      </div>
    <% end %>
  </section>
</main>
