<div class="container py-4">
  <div class="row">
    <div class="col-12 col-md-8 col-lg-6 mx-auto">
      <div class="paw-form">

        <h2 class="mb-1">Pawst a job</h2>
        <p class="text-body-secondary mb-4">Ask your paw-neighbour for help.</p>

        <%= simple_form_for @listing do |f| %>
          <%= f.error_notification %>

          <%= render "listings/pet_picker", form: f, pets: @pets %>

          <%= f.input :listing_type,
                      label: "What kind of help?",
                      collection: Listing::TYPES,
                      include_blank: "Choose the help you need" %>

          <div class="row g-3">
            <div class="col-6">
              <%= f.input :start_date,
                          as: :string,
                          label: "From",
                          input_html: { type: "date", min: Date.current } %>
            </div>
            <div class="col-6">
              <%= f.input :end_date,
                          as: :string,
                          label: "To",
                          input_html: { type: "date", min: Date.current } %>
            </div>
          </div>

          <%= f.input :listing_note,
                      label: "Listing details",
                      placeholder: "What help your pet needs...",
                      input_html: { rows: 4 } %>

          <%= f.button :submit, "Paw-lease help!",
                      class: "btn btn-primary rounded-pill w-100 mt-3" %>
        <% end %>

      </div>
    </div>
  </div>
</main>
