<% content_for :title, "Pawst a job | Pawneighbour" %>

<main class="listing-form-page">
  <div class="container listing-form-page__container">
    <section class="paw-form" aria-labelledby="new-listing-title">
      <header class="paw-form__header">
        <span class="paw-form__icon" aria-hidden="true">
          <i class="fa-solid fa-paw"></i>
        </span>
        <h1 id="new-listing-title">Pawst a job</h1>
        <p>Ask a trusted paw-neighbour for help with your pets.</p>
      </header>

      <% if @listing.errors.any? %>
        <div class="paw-form__error-summary" role="alert" aria-live="polite">
          <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
          <div>
            <p class="paw-form__error-title">We couldn't pawst your job yet.</p>
            <p>Please check the highlighted fields below.</p>
          </div>
        </div>
      <% end %>

      <p class="paw-form__required-note">
        <span aria-hidden="true">*</span> Required fields
      </p>

      <%= simple_form_for @listing, html: { class: "paw-form__fields" } do |f| %>
        <%= render "listings/pet_picker", form: f, pets: @pets %>

        <%= f.input :listing_type,
                    label: "What kind of help?",
                    collection: Listing::TYPES,
                    include_blank: "Choose the help you need",
                    required: true %>

        <div class="paw-form__date-grid">
          <%= f.input :start_date,
                      as: :string,
                      label: "From",
                      required: true,
                      input_html: { type: "date", min: Date.current } %>

          <%= f.input :end_date,
                      as: :string,
                      label: "To",
                      required: true,
                      input_html: { type: "date", min: Date.current } %>
        </div>

        <%= f.input :listing_note,
                    as: :text,
                    label: "Listing details",
                    placeholder: "What help your pets need...",
                    hint: "Optional — share routines, timing or anything your neighbour should know.",
                    input_html: { rows: 5 } %>

        <%= button_tag type: "submit", class: "paw-form__submit" do %>
          <i class="fa-solid fa-paw" aria-hidden="true"></i>
          <span>Paw-lease help!</span>
        <% end %>
      <% end %>
    </section>
  </div>
</main>
