<% pets  = listing.pets %>
<% owner = listing.owner %>

<div class="col">
  <article class="card bg-white h-100 shadow-sm rounded-4 overflow-hidden">

    <%= render "listings/pet_media", pets: listing.pets %>

    <div class="card-body d-flex flex-column">
      <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
        <h3 class="h5 mb-0"><%= pets.map(&:name).to_sentence %></h3>
        <span class="badge rounded-pill text-bg-info flex-shrink-0">
          <%= listing.listing_type %>
        </span>
      </div>

      <p class="text-body-secondary small mb-3">
        <%= listing.start_date.strftime("%-d %b") %> –
        <%= listing.end_date.strftime("%-d %b") %>
      </p>

      <p class="card-text small mb-3">
        <%= truncate(listing.listing_note.presence || "No additional information provided.",
                   length: 90) %>
      </p>

      <div class="d-flex align-items-center gap-2 mb-3">
        <%= avatar_for(owner, size: 28) %>
        <div class="small lh-sm">
          <div><%= owner.name %></div>
          <div class="text-body-secondary">
            <i class="fa-solid fa-location-dot me-1" aria-hidden="true"></i><%= owner.location %>
          </div>
        </div>
      </div>

      <% if (trust = trust_signal(current_user, owner)) %>
        <p class="trust trust--<%= trust[:key] %> small mb-3"><%= trust[:label] %></p>
      <% end %>

      <div class="mt-auto">
        <%= link_to "View & offer", listing_path(listing),
                    class: "btn btn-primary rounded-pill w-100" %>
      </div>
    </div>
  </article>
</div>
