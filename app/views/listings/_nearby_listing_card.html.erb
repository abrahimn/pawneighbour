<% pets  = listing.pets %>
<% owner = listing.owner %>

<div class="col">
  <article class="listing-card card h-100">

    <div class="position-relative">
      <%= render "listings/pet_media", pets: pets %>

      <span class="badge rounded-pill text-bg-info listing-card__type">
        <%= listing.listing_type %>
      </span>

      <span class="listing-card__owner">
        <%= avatar_for(owner, size: 44) %>
      </span>
    </div>

    <div class="card-body d-flex flex-column">

      <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
        <div>
          <h3 class="h5 mb-1"><%= pets.map(&:name).to_sentence %></h3>
          <div class="listing-card__place">
            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
            <%= owner.location %>
          </div>
          <p class="listing-card__dates mt-2">
            <%= listing.start_date.strftime("%-d %b") %> –
            <%= listing.end_date.strftime("%-d %b") %>
          </p>
        </div>

        <div class="listing-card__owner-meta text-end mx-2">
          <div class="listing-card__owner-name"><%= owner.name %></div>
        </div>
      </div>



      <div class="d-flex justify-content-between align-items-center gap-1 mt-auto">
        <p class="listing-card__note mb-0">
          <%= truncate(listing.listing_note.presence || "No additional information provided.",
                       length:100) %>
        </p>

        <%= link_to "View", listing_path(listing),
                    class: "btn btn-primary rounded-pill flex-shrink-0" %>
      </div>
    </div>
  </article>
</div>
