<% content_for :title, "#{@listing.pet.name} | Pawneighbour" %>

<main class="container py-4">
  <%# <%= link_to "← Back to listings", listings_path, class: "btn btn-info mb-4" %>

  <article class="card bg-white shadow-sm overflow-hidden">
    <div class="row g-0">
      <% if @listing.pet.avatar.attached? %>
        <div class="ratio ratio-4x3">
          <%= cl_image_tag @listing.pet.avatar.key,
                           class: "object-fit-cover",
                           alt: @listing.pet.name %>
        </div>
      <% end %>

      <div class="<%= @listing.pet.avatar.attached? ? 'col-sm-7' : 'col-12' %>">
        <div class="card-body col-xs-5 p-4">
          <div class="btn btn-info btn-sm mb-2"><%= @listing.listing_type %></div>
          <h1 class="card-title"><%= @listing.pet.name %></h1>
          <p class="text-muted mb-4">
            <%= @listing.pet.species %> · <%= pluralize(@listing.pet.age, "year") %> old
          </p>

          <dl class="row mb-4">
            <dt class="col-xs-4">Dates</dt>
            <dd class="col-xs-8">
              <%= l(@listing.start_date, format: :long) %> –
              <%= l(@listing.end_date, format: :long) %>
            </dd>

            <dt class="col-xs-4">Pet owner</dt>
            <dd class="col-xs-8"><%= @listing.owner.name %></dd>

            <% if @listing.owner.location.present? %>
              <dt class="col-xs-4">Location</dt>
              <dd class="col-xs-8"><%= @listing.owner.location %></dd>
            <% end %>
          </dl>

          <section class="mb-4">
            <h2 class="h5">What I need</h2>
            <p class="mb-0"><%= @listing.listing_note.presence || "No additional notes provided." %></p>
          </section>

          <section>
            <h2 class="h5">Care instructions</h2>
            <p class="mb-0"><%= @listing.pet.care_instructions.presence || "No care instructions provided." %></p>
          </section>

          <% if @listing.pet.user == current_user %>
            <%= link_to "You have #{@listing.offers.count} paw-proposals 🐾 ",
              listing_offers_path(@listing),
              class: "btn btn-outline-info w-100 mt-4 px-3" %>
          <% else %>

          <section>
            <% if @listing.offers.exists?(user: current_user) %>
              <span class="btn btn-success my-4 w-100">Offer sent</span>
            <% else %>
              <%= button_to "Make an offer", listing_offers_path(@listing), class: "btn btn-primary my-4 w-100" %>
            <% end %>
          </section>
          <% end %>

        </div>
      </div>
    </div>


  </article>

</main>
