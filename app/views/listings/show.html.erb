<% pets = @listing.pets %>
<% hero = pets.first %>
<% owner = @listing.owner %>

<% content_for :title, "#{pets.map(&:name).to_sentence} | PawNeighbour" %>

<div class="container py-4">
  <div class="card bg-white shadow-sm overflow-hidden">

<%# ---------- hero photo ---------- %>
<% carousel_id = "listing-#{@listing.id}-photos" %>

<% if pets.size > 1 %>
  <div id="<%= carousel_id %>" class="carousel slide listing-carousel">
    <div class="carousel-indicators">
      <% pets.each_with_index do |pet, i| %>
        <button type="button"
                data-bs-target="#<%= carousel_id %>"
                data-bs-slide-to="<%= i %>"
                class="<%= "active" if i.zero? %>"
                aria-current="<%= i.zero? %>"
                aria-label="Photo of <%= pet.name %>"></button>
      <% end %>
    </div>

    <div class="carousel-inner">
      <% pets.each_with_index do |pet, i| %>
        <div class="carousel-item <%= "active" if i.zero? %>">
          <div class="ratio ratio-4x3">
            <img src="<%= pet_photo_url(pet, size: 1200) %>"
                 class="listing-detail__image"
                 style="object-position: <%= pet_focal_position(pet) %>"
                 alt="<%= pet.name %>">
          </div>
          <div class="carousel-caption listing-carousel__caption">
            <span class="badge rounded-pill text-bg-light">
              <%= pet.name %> · <%= pluralize(pet.age, "year") %> old
            </span>
          </div>
        </div>
      <% end %>
    </div>

    <button class="carousel-control-prev" type="button"
            data-bs-target="#<%= carousel_id %>" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Previous pet</span>
    </button>

    <button class="carousel-control-next" type="button"
            data-bs-target="#<%= carousel_id %>" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Next pet</span>
    </button>
  </div>

<% else %>
  <div class="ratio ratio-4x3">
    <img src="<%= pet_photo_url(hero, size: 1200) %>"
         class="listing-detail__image"
         style="object-position: <%= pet_focal_position(hero) %>"
         alt="<%= hero&.name %>">
  </div>
<% end %>

    <div class="card-body p-4">

      <%# ---------- pets ---------- %>
      <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
        <div>
          <h1 class="h3 mb-1"><%= pets.map(&:name).to_sentence %></h1>
        </div>

        <span class="badge rounded-pill text-bg-info flex-shrink-0">
          <%= @listing.listing_type %>
        </span>
      </div>

      <div class="h5 text-info mb-3">
        <%= l(@listing.start_date, format: :short) %> –
        <%= l(@listing.end_date, format: :short) %>
      </div>

      <%# ---------- owner ---------- %>
      <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-2">
          <%= avatar_for(owner) %>
          <div class="lh-sm">
            <div><%= owner.name %></div>
            <% if (trust = trust_signal(current_user, owner)) %>
              <span class="trust trust--<%= trust[:key] %> small"><%= trust[:label] %></span>
            <% end %>
          </div>
        </div>

        <% if owner.location.present? %>
          <div class="text-body-secondary small flex-shrink-0">
            <i class="fa-solid fa-map-pin me-1" aria-hidden="true"></i><%= owner.location %>
          </div>
        <% end %>
      </div>

      <%# ---------- what I need ---------- %>
      <div class="mb-4">
        <p class="mb-0">
          <%= @listing.listing_note.presence || "No additional notes provided." %>
        </p>
      </div>

      <%# ---------- matched: contact + care notes ---------- %>
      <% if @matched_user.present? %>
        <div class="care-notes shadow-sm">
          <div class="p-2 mb-3">
            <div class="d-flex align-items-center gap-3">
              <div>
                <h2 class="h4 m-1">
                  <% if owner == current_user %>
                    You accepted <%= @matched_user.name %>'s offer
                  <% else %>
                    <%= @matched_user.name %> accepted your offer
                  <% end %>
                </h2>

                <% if @matched_user.location.present? %>
                  <p class="text-body-secondary mb-0">
                    <i class="fa-solid fa-map-pin me-1" aria-hidden="true"></i>
                    <%= @matched_user.location %>
                  </p>
                <% end %>
              </div>
            </div>

            <div class="row g-2 mt-3">
              <div class="col-6">
                <%= mail_to @matched_user.email,
                            class: "btn btn-success w-100 d-inline-flex align-items-center justify-content-center gap-2" do %>
                  <i class="fa-regular fa-envelope" aria-hidden="true"></i>
                  <span>Email <%= @matched_user.name %></span>
                <% end %>
              </div>

              <% if @matched_user.mobile.present? %>
                <div class="col-6">
                  <%= sms_to @matched_user.mobile,
                             class: "btn btn-success w-100 d-inline-flex align-items-center justify-content-center gap-2" do %>
                    <i class="fa-regular fa-message" aria-hidden="true"></i>
                    <span>Message <%= @matched_user.name %></span>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>

          <div class="p-2">
            <h2 class="h5 mb-3">Care instructions</h2>
            <% pets.each do |pet| %>
              <div class="mb-3">
                <h3 class="h6 mb-1"><%= pet.name %></h3>
                <p class="mb-0 text-body-secondary">
                  <%= pet.care_instructions.presence || "No care instructions provided." %>
                </p>
              </div>
            <% end %>
          </div>
        </div>

      <%# ---------- owner, no match yet ---------- %>
      <% elsif owner == current_user %>
        <% count = @listing.offers.count %>
        <% if count.zero? %>
          <span class="btn btn-outline-secondary w-100 mt-4 disabled">
            No paw-proposals yet 🐾
          </span>
        <% else %>
          <%= link_to "You have #{pluralize(count, 'paw-proposal')} 🐾",
                      listing_offers_path(@listing),
                      class: "btn btn-outline-info w-100 mt-4" %>
        <% end %>

      <%# ---------- sitter view ---------- %>
      <% else %>
        <% my_offer = @listing.offers.find_by(user: current_user) %>

        <% if @accepted_offer.present? %>
          <% if my_offer.present? %>
            <span class="btn btn-secondary w-100 my-4 disabled">
              Not selected this time 🐾
            </span>
          <% else %>
            <span class="btn btn-secondary w-100 my-4 disabled">
              <%= owner.name %> has found a sitter
            </span>
          <% end %>

        <% elsif my_offer.present? %>
          <span class="btn btn-info w-100 my-4 disabled">
            Owner is reviewing your offer
          </span>

        <% else %>
          <%= button_to "Make an offer", listing_offers_path(@listing),
                        class: "btn btn-primary w-100 my-4" %>
        <% end %>
      <% end %>

    </div>
  </div>
</div>
