<% content_for :title, "#{@listing.pet.name} | Pawneighbour" %>

<main class="page-shell listing-detail-page">
  <article class="listing-detail">
    <div class="listing-detail__media">
      <% if @listing.pet.avatar.attached? %>
        <%= cl_image_tag @listing.pet.avatar.key,
                         width: 1400,
                         crop: :scale,
                         class: "listing-detail__image",
                         style: "object-position: #{pet_focal_position(@listing.pet)}",
                         alt: @listing.pet.name %>
      <% else %>
        <div class="listing-detail__media-placeholder" aria-hidden="true">
          <i class="fa-solid fa-paw"></i>
        </div>
      <% end %>

      <span class="listing-detail__type"><%= @listing.listing_type %></span>
    </div>

    <div class="listing-detail__body">
      <header class="listing-detail__header">
        <h1><%= @listing.pet.name %></h1>
        <p class="listing-detail__subhead">
          <%= @listing.pet.species %> · <%= pluralize(@listing.pet.age, "year") %> old
        </p>
      </header>

      <dl class="listing-detail__facts">
        <div class="listing-detail__fact listing-detail__fact--wide">
          <dt>
            <i class="fa-regular fa-calendar" aria-hidden="true"></i>
            <span class="visually-hidden">Dates</span>
          </dt>
          <dd>
            <time datetime="<%= @listing.start_date.iso8601 %>"><%= l(@listing.start_date, format: :long) %></time>
            <span aria-hidden="true">→</span>
            <time datetime="<%= @listing.end_date.iso8601 %>"><%= l(@listing.end_date, format: :long) %></time>
          </dd>
        </div>

        <div class="listing-detail__fact">
          <dt>
            <i class="fa-regular fa-user" aria-hidden="true"></i>
            <span class="visually-hidden">Pet owner</span>
          </dt>
          <dd><%= @listing.owner.name %></dd>
        </div>

        <% if @listing.owner.location.present? %>
          <div class="listing-detail__fact">
            <dt>
              <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
              <span class="visually-hidden">Location</span>
            </dt>
            <dd><%= @listing.owner.location %></dd>
          </div>
        <% end %>
      </dl>

      <section class="listing-detail__note">
        <h2>What I need</h2>
        <p><%= @listing.listing_note.presence || "No additional notes provided." %></p>
      </section>

      <section class="listing-detail__note">
        <h2>Care instructions</h2>
        <p><%= @listing.pet.care_instructions.presence || "No care instructions provided." %></p>
      </section>

      <div class="listing-detail__actions">
        <% if @matched_user.present? %>
          <section class="match-card">
            <div class="card-body p-4">
              <div class="d-flex align-items-center gap-3">
                <%= avatar_for(@matched_user, size: 56) %>

                <div>
                  <span class="badge rounded-pill text-bg-success mb-2">It’s a match!</span>
                  <h2 class="h5 mb-1">
                    <% if @listing.owner == current_user %>
                      You accepted <%= @matched_user.name %>’s offer
                    <% else %>
                      <%= @matched_user.name %> accepted your offer
                    <% end %>
                  </h2>

                  <% if @matched_user.location.present? %>
                    <p class="text-body-secondary small mb-0">
                      <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                      <%= @matched_user.location %>
                    </p>
                  <% end %>
                </div>
              </div>

              <div class="row g-2 mt-3">
                <div class="col-12 col-sm-6">
                  <%= mail_to @matched_user.email, class: "btn btn-primary w-100" do %>
                    <i class="fa-solid fa-envelope me-1" aria-hidden="true"></i>
                    Email <%= @matched_user.name %>
                  <% end %>
                </div>

                <% if @matched_user.mobile.present? %>
                  <div class="col-12 col-sm-6">
                    <%= sms_to @matched_user.mobile, class: "btn btn-primary w-100" do %>
                      <i class="fa-solid fa-message me-1" aria-hidden="true"></i>
                      Message <%= @matched_user.name %>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          </section>
        <% elsif @listing.owner == current_user %>
          <%= link_to "You have #{@listing.offers.count} paw-proposals 🐾",
                      listing_offers_path(@listing),
                      class: "btn btn-outline-primary w-100 px-3" %>
        <% elsif @listing.offers.exists?(user: current_user) %>
          <span class="btn btn-success w-100" role="status">
            <i class="fa-solid fa-check me-1" aria-hidden="true"></i> Offer sent
          </span>
        <% else %>
          <%= button_to listing_offers_path(@listing),
                        class: "btn btn-primary w-100",
                        form_class: "w-100" do %>
            Make an offer <i class="fa-solid fa-arrow-right ms-1" aria-hidden="true"></i>
          <% end %>
        <% end %>
      </div>
    </div>
  </article>
</main>
