<div class="col">
  <article class="card bg-white h-100 shadow-sm overflow-hidden">
    <% if listing.pet.avatar.attached? %>
      <%= cl_image_tag listing.pet.avatar.key,
                       width: 500,
                       height: 300,
                       crop: :fill,
                       class: "card-img-top object-fit-cover",
                       alt: listing.pet.name %>
    <% else %>
      <div class="listing-card__image-placeholder">
        <i class="fa-solid fa-paw"></i>
      </div>
    <% end %>

    <div class="card-body d-flex flex-column">
      <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
        <h3 class="h5 mb-0">
          <%= listing.pet.name %>
        </h3>

        <% if listing.accepted_offer.present? %>
          <span class="badge rounded-pill text-bg-success">
            Matched
          </span>
        <% elsif listing.pending_offers.any? %>
          <span class="badge rounded-pill text-bg-warning">
            <%= pluralize(listing.pending_offers.size, "offer") %>
          </span>
        <% else %>
          <span class="badge rounded-pill text-bg-secondary">
            Waiting
          </span>
        <% end %>
      </div>

      <p class="text-body-secondary small mb-3">
        <%= listing.listing_type %> ·
        <%= listing.start_date.strftime("%-d %b") %> –
        <%= listing.end_date.strftime("%-d %b") %>
      </p>

      <p class="card-text mb-3">
        <%= listing.listing_note.presence ||
            "No additional information provided." %>
      </p>

      <% if listing.accepted_offer.present? %>
        <p class="text-body-secondary small mb-3">
          <i class="fa-solid fa-circle-check text-success me-1"></i>
          Matched with
          <%= listing.accepted_offer.user.name %>
        </p>
      <% else %>
        <p class="text-body-secondary small mb-3">
          <i class="fa-solid fa-location-dot text-danger me-1"></i>
          <%= current_user.location %>
        </p>
      <% end %>

      <div class="mt-auto">
        <% if listing.pending_offers.any? &&
              listing.accepted_offer.blank? %>
          <%= link_to "Review offers",
                      listing_offers_path(listing),
                      class: "btn btn-primary rounded-pill w-100" %>
        <% else %>
          <%= link_to listing.accepted_offer.present? ? "View match" : "View listing",
                      listing_path(listing),
                      class: "btn btn-primary rounded-pill w-100" %>
        <% end %>
      </div>
    </div>
  </article>
</div>
