<% pet = listing.pet %>

<article class="card activity-card">
  <div class="card-body d-flex justify-content-between align-items-center gap-3">
    <div class="d-flex align-items-center gap-3">
      <% if pet.avatar.attached? %>
        <%= cl_image_tag pet.avatar.key,
                         width: 56,
                         height: 56,
                         crop: :fill,
                         gravity: :auto,
                         class: "rounded-circle object-fit-cover flex-shrink-0",
                         alt: pet.name %>
      <% else %>
        <div class="avatar bg-light d-flex align-items-center justify-content-center">
          <i class="fa-solid fa-paw"></i>
        </div>
      <% end %>

      <div>
        <h3 class="h6 mb-1"><%= pet.name %></h3>

        <p class="text-body-secondary small mb-1">
          <%= listing.listing_type %> ·
          <%= listing.start_date.strftime("%-d %b") %> –
          <%= listing.end_date.strftime("%-d %b") %>
        </p>

        <% if listing.accepted_offer.present? %>
          <span class="badge rounded-pill text-bg-success">
            Matched
          </span>
        <% elsif listing.pending_offers.any? %>
          <span class="badge rounded-pill text-bg-warning">
            <%= pluralize(listing.pending_offers.size, "offer") %>
          </span>
        <% else %>
          <span class="badge rounded-pill text-bg-secondary">
            Waiting
          </span>
        <% end %>
      </div>
    </div>

    <% if listing.pending_offers.any? && listing.accepted_offer.blank? %>
      <%= link_to "Review",
                  listing_offers_path(listing),
                  class: "btn btn-primary rounded-pill flex-shrink-0" %>
    <% else %>
      <%= link_to listing.accepted_offer.present? ? "View match" : "View",
                  listing_path(listing),
                  class: "btn btn-primary rounded-pill flex-shrink-0" %>
    <% end %>
  </div>
</article>
