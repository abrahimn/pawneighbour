<% pets = listing.pets %>

<article class="card bg-white shadow-sm">
  <div class="card-body d-flex justify-content-between align-items-center gap-3">
    <div class="d-flex align-items-center gap-3">

      <div class="pet-stack flex-shrink-0">
        <% pets.first(3).each do |pet| %>
          <img src="<%= pet_photo_url(pet, size: 120) %>"
              class="pet-stack__photo" alt="">
        <% end %>
      </div>

      <div>
        <h3 class="h6 mb-1"><%= pets.map(&:name).to_sentence %></h3>

        <p class="text-body-secondary small mb-1">
          <%= listing.listing_type %> ·
          <%= listing.start_date.strftime("%-d %b") %> –
          <%= listing.end_date.strftime("%-d %b") %>
        </p>

        <% if listing.accepted_offer.present? %>
          <span class="status-badge status-badge--matched">Matched</span>
        <% elsif listing.pending_offers.any? %>
          <span class="status-badge status-badge--pending">
            <%= pluralize(listing.pending_offers.size, "offer") %>
          </span>
        <% else %>
          <span class="status-badge status-badge--past">Waiting</span>
        <% end %>
      </div>
    </div>

    <% if listing.pending_offers.any? && listing.accepted_offer.blank? %>
      <%= link_to "Review", listing_offers_path(listing),
                  class: "btn btn-primary rounded-pill flex-shrink-0" %>
    <% else %>
      <%= link_to listing.accepted_offer.present? ? "View match" : "View",
                  listing_path(listing),
                  class: "btn btn-primary rounded-pill flex-shrink-0" %>
    <% end %>
  </div>
</article>
