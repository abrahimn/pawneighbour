<% listing = offer.listing %>
<% pet = listing.pet %>

<article class="card bg-white shadow-sm">
  <div class="card-body d-flex justify-content-between align-items-center gap-3">
    <div class="d-flex align-items-center gap-3">
      <% if pet.avatar.attached? %>
        <%= cl_image_tag pet.avatar.key,
                         width: 56,
                         height: 56,
                         crop: :fill,
                         gravity: :auto,
                         class: "rounded-circle object-fit-cover flex-shrink-0",
                         alt: pet.name %>
      <% else %>
        <div class="avatar bg-light d-flex align-items-center justify-content-center">
          <i class="fa-solid fa-paw"></i>
        </div>
      <% end %>

      <div>
        <h3 class="h6 mb-1">
          <%= pet.name %>
        </h3>

        <p class="text-body-secondary small mb-0">
          <%= listing.listing_type %> ·
          <%= listing.start_date.strftime("%-d %b") %>
        </p>

        <span class="badge rounded-pill text-bg-secondary mt-2">
          Not selected
        </span>
      </div>
    </div>

    <%= link_to "View",
                listing_path(listing),
                class: "btn btn-sm btn-outline-secondary rounded-pill" %>
  </div>
</article>
