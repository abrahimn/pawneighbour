<% listing = offer.listing %>

<article class="card bg-white shadow-sm">
  <div class="card-body d-flex justify-content-between align-items-center gap-3">
    <div class="d-flex align-items-center gap-3">
      <%= render "shared/pet_stack", pets: listing.pets %>

      <div>
        <h3 class="h6 mb-1"><%= listing.pets.map(&:name).to_sentence %></h3>

        <p class="text-body-secondary small mb-0">
          <%= listing.listing_type %> ·
          <%= listing.start_date.strftime("%-d %b") %>
        </p>

        <% label, variant = offer_status_badge(offer.status) %>
        <span class="status-badge status-badge--<%= variant %> mt-2"><%= label %></span>
    </div>

    <%= link_to "View", listing_path(listing),
                class: "btn btn-sm btn-outline-secondary rounded-pill" %>
  </div>
</article>
