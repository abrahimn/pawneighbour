<%= form_with url: listings_path, method: :get, class: "listing-filter mb-4" do |f| %>
  <label class="listing-filter__label" for="radius">
    <i class="fa-solid fa-compass" aria-hidden="true"></i>
    Search range
  </label>

  <div class="listing-filter__controls">

    <%= f.select :radius,
                options_for_select([
                  ["My neighbourhood · 3 km",   3],
                  ["Worth the walkies · 5 km",  5],
                  ["Short drive · 10 km",      10],
                  ["Fur-ther afield · 25 km", 25]],
                  @radius.to_i),
                {},
                class: "form-select listing-filter__select",
                "aria-label": "Search radius",
                onchange: "this.form.requestSubmit()" %>

  </div>

  <%= f.hidden_field :latitude,  value: @latitude %>
  <%= f.hidden_field :longitude, value: @longitude %>
<% end %>
