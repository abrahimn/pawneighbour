<% content_for :title, "My activity | PawNeighbour" %>

<main class="page-shell marketplace-page">
  <header class="neighbourhood-hero mb-5" aria-labelledby="activity-title">
    <span class="neighbourhood-hero__pet neighbourhood-hero__pet--pug" aria-hidden="true">
      <%= image_tag "pug-transparent.png",
                    class: "neighbourhood-hero__pug-layer neighbourhood-hero__pug-body",
                    alt: "" %>
      <%= image_tag "pug-transparent.png",
                    class: "neighbourhood-hero__pug-layer neighbourhood-hero__pug-tongue",
                    alt: "" %>
    </span>

    <span class="neighbourhood-hero__cat" aria-hidden="true">
      <%= image_tag "playful-cat-transparent.png",
                    class: "neighbourhood-hero__cat-layer neighbourhood-hero__cat-body",
                    alt: "" %>
      <%= image_tag "playful-cat-transparent.png",
                    class: "neighbourhood-hero__cat-layer neighbourhood-hero__cat-tail",
                    alt: "" %>
    </span>

    <div class="neighbourhood-hero__content">
      <span class="neighbourhood-hero__issue" aria-hidden="true">YOUR PATCH / LIVE</span>
      <span class="neighbourhood-hero__eyebrow">
        🐾 <%= current_user.name %> · at a glance
      </span>

      <h1 class="neighbourhood-hero__title" id="activity-title">My activity</h1>

      <p class="neighbourhood-hero__description">
        Keep track of your pet-care requests, offers and matches.
      </p>

      <div class="d-flex flex-column align-items-start w-30 mt-3">
        <%= link_to new_listing_path,
                    class: "btn neighbourhood-hero__button rounded-pill mb-3" do %>
          Pin a request
          <span aria-hidden="true">↗</span>
        <% end %>

        <%= link_to new_amber_alert_path,
                    class: "btn neighbourhood-hero__button rounded-pill" do %>
          Report a missing
          <span aria-hidden="true">↗</span>
        <% end %>
      </div>
    </div>
    <div class="neighbourhood-hero__stamp" aria-hidden="true">
      <span>KEEPING TABS</span>
      <strong>ALL PAWS</strong>
      <span>ONE PLACE</span>
    </div>
  </header>

  <%# ---------- Needs your attention ---------- %>
  <% if @attention_listings.any? %>
    <details class="dashboard-disclosure mb-5" open>
      <%= render "listings/disclosure_summary",
                 title: "Needs your attention",
                 count: @attention_listings.size %>

      <div class="d-grid gap-2 mt-3">
        <%= render partial: "my_listing_card",
                   collection: @attention_listings,
                   as: :listing %>
      </div>
    </details>
  <% end %>

  <%# ---------- My listings ---------- %>
  <details class="dashboard-disclosure mb-5" open>
    <%= render "listings/disclosure_summary",
               title: "My listings",
               count: @my_listings.size %>

    <div class="mt-3">
      <% if @my_listings.any? %>
        <div class="d-grid gap-2">
          <%= render partial: "my_listing_card",
                     collection: @my_listings,
                     as: :listing %>
        </div>
      <% else %>
        <div class="card border-0 bg-light">
          <div class="card-body text-center py-4">
            <h3 class="h5">No upcoming listings</h3>
            <p class="text-body-secondary">Need someone to care for your pet?</p>
            <%= link_to "Ask a neighbour for help",
                        new_listing_path,
                        class: "btn btn-primary rounded-pill" %>
          </div>
        </div>
      <% end %>
    </div>
  </details>

  <%# ---------- My offers ---------- %>
  <details class="dashboard-disclosure mb-5" open>
    <%= render "listings/disclosure_summary",
               title: "My offers",
               count: @current_offers.size %>

    <div class="mt-3">
      <% if @current_offers.any? %>
        <div class="d-grid gap-2">
          <%= render partial: "my_offer_card",
                     collection: @current_offers,
                     as: :offer %>
        </div>
      <% else %>
        <div class="card border-0 bg-light">
          <div class="card-body text-center py-4">
            <h3 class="h5">You haven’t offered yet</h3>
            <p class="text-body-secondary mb-3">
              Take a look at the neighbours who need a helping paw.
            </p>
            <%= link_to "Browse the board", listings_path,
                        class: "btn btn-primary rounded-pill" %>
          </div>
        </div>
      <% end %>
    </div>
  </details>

  <%# ---------- Past activity (closed by default) ---------- %>
  <% if @past_offers.any? %>
    <details class="dashboard-disclosure mb-5">
      <%= render "listings/disclosure_summary",
                 title: "Past activity",
                 count: @past_offers.size %>

      <div class="d-grid gap-2 mt-3">
        <%= render partial: "past_offer",
                   collection: @past_offers,
                   as: :offer %>
      </div>
    </details>
  <% end %>
</main>
