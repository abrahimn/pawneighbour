<% listing = offer.listing %>
<% pet = listing.pet %>
<% owner = listing.owner %>

<div class="col">
  <article class="card bg-white h-100 shadow-sm overflow-hidden">
    <% if pet.avatar.attached? %>
      <%= cl_image_tag pet.avatar.key,
                      height: 300,
                      width: 500,
                      crop: :fill,
                      class: "card-img-top object-fit-cover",
                      alt: pet.name %>
    <% else %>
      <div class="listing-card__image-placeholder">
        <i class="fa-solid fa-paw"></i>
      </div>
    <% end %>

    <div class="card-body d-flex flex-column">
      <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
        <h3 class="h5 mb-0">
          <%= pet.name %>
        </h3>

        <% case offer.status %>
        <% when "accepted" %>
          <span class="badge rounded-pill text-bg-success">
            Matched
          </span>
        <% when "rejected" %>
          <span class="badge rounded-pill text-bg-secondary">
            Not selected
          </span>
        <% else %>
          <span class="badge rounded-pill text-bg-info">
            Pending
          </span>
        <% end %>
      </div>

      <p class="text-body-secondary small mb-3">
        <%= listing.listing_type %> ·
        <%= listing.start_date.strftime("%-d %b") %> –
        <%= listing.end_date.strftime("%-d %b") %>
      </p>

      <p class="card-text mb-3">
        <%= listing.listing_note.presence ||
            "No additional information provided." %>
      </p>

      <p class="text-body-secondary small mb-3">
        <i class="fa-solid fa-location-dot text-danger me-1"></i>
        <%= owner.location %>
      </p>

      <div class="mt-auto">
        <%= link_to offer.status == "accepted" ? "View match" : "View listing",
                    listing_path(listing),
                    class: "btn btn-primary rounded-pill w-100" %>
      </div>
    </div>
  </article>
</div>
