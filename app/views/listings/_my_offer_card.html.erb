<% listing = offer.listing %>
<% pets    = listing.pets %>

<article class="card activity-card">
  <div class="card-body d-flex justify-content-between align-items-center gap-3">
    <div class="d-flex align-items-center gap-3">

      <div class="pet-stack flex-shrink-0">
        <% pets.first(3).each do |pet| %>
          <img src="<%= pet_photo_url(pet, size: 120) %>"
               class="pet-stack__photo" alt="">
        <% end %>
      </div>

      <div>
        <h3 class="h6 mb-1"><%= pets.map(&:name).to_sentence %></h3>

        <p class="text-body-secondary small mb-1">
          <%= listing.listing_type %> ·
          <%= listing.start_date.strftime("%-d %b") %> –
          <%= listing.end_date.strftime("%-d %b") %>
        </p>

        <% label, variant = offer_status_badge(offer.status) %>
        <span class="status-badge status-badge--<%= variant %> mt-2"><%= label %></span>
      </div>
    </div>

    <%= link_to offer.status == "accepted" ? "View match" : "View",
                listing_path(listing),
                class: "btn btn-primary rounded-pill flex-shrink-0" %>
  </div>
</article>
